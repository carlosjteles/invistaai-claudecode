// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  thumbnail    String
  image        String
  tag          String
  author       String
  title        String
  description  String
  keywords     String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relationship with BlogContent
  content      BlogContent[]
}

model BlogContent {
  id      Int    @id @default(autoincrement())
  type    String // availables 'text', 'quote', 'link'
  value   String
  author  String?
  href    String?
  
  // Relationship with Blog
  blog    Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  blogId  Int
  order   Int 
}

model Property {
  id                Int      @id @default(autoincrement())
  external_id       String
  slug              String   @unique
  name              String
  address           String
  neighborhood      String
  bedroom           Json
  suite             Int[]
  parking           Int[]
  min_area          Float
  price             Float
  rating            Float?
  quantity_reviews  Int?
  category          Int
  delivery_in       String
  release_in        String
  book              String?
  video             String?
  description       Json
  attributes        String[]
  description_embed String?
  preview           Json
  seo               Json
  typelogies        Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt  

  // Relationship with PropertyImage
  images            PropertyImage[]

}

model PropertyImage {
  id          Int      @id @default(autoincrement())
  src         String
  alt         String
  type        String
  thumbnail   Boolean @default(false)
  
  // Relationship with Property
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  Int
  order       Int
}